# Kimi For Coding API key (Moonshot subscription endpoint)
KIMI_API_KEY=
# Model id override (default: kimi-k2.5 — verify ids in @earendil-works/pi-ai)
YTL_AGENT_MODEL=
# Port override for the agentd HTTP server (default: 8472)
YTL_AGENT_PORT=
# Set to 1 to use pi-ai's faux provider instead of Kimi (self-tests, no network)
YTL_FAUX_MODEL=
